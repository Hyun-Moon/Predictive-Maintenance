# --- 가상환경 -------------------------------------------------------------
.venv/
venv/
env/

# --- 파이썬 ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- 데이터 (중요!) -------------------------------------------------------
# 원본 데이터는 절대 git 에 올리지 않습니다.
#   1) 용량이 큼 (GitHub 파일당 100MB 제한)
#   2) 라이선스/재배포 문제
#   3) README 의 다운로드 절차만 있으면 누구나 재현 가능
# 대신 폴더 구조는 유지되도록 .gitkeep 만 추적합니다.
data/**
!data/**/
!data/**/.gitkeep

# 학습된 모델 파일도 용량이 크므로 제외 (재현은 스크립트로)
# 앞에 "/" 를 붙여 최상위 models/ 폴더만 지정합니다.
# 그냥 "models/" 로 쓰면 소스코드 폴더인 src/models/ 까지 무시되어 버립니다.
/models/
*.pkl
*.joblib
*.pt

# --- 리포트 산출물 --------------------------------------------------------
# 그림(figures)은 README 에서 보여줘야 하므로 git 에 포함합니다.
# 대신 중간 산출물/캐시는 제외.
reports/**/*.tmp

# --- OS / 에디터 ----------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
